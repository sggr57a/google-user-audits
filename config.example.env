# Copy to config.env and fill in real values, then the scripts will `source` it.

# Your primary Workspace domain.
DOMAIN="example.com"

# Active account that receives transferred Drive data and runs the analysis.
# Use a DEDICATED account with no other Drive activity (needed for accurate attribution).
HOLDING_ACCOUNT="drive-audit-holding@example.com"

# Suspension proxy: accounts whose lastLoginTime is on/before this date are treated as
# "suspended 5+ years" (there is no native 'date suspended' field). Format: YYYY-MM-DD.
# Set to ~5 years before today.
SUSPENDED_BEFORE="2020-09-17"

# Staleness cutoff for Drive files: files not modified since this date are "stale".
# Set to 1 or 2 years before today. Format: YYYY-MM-DD.
STALE_BEFORE="2024-09-17"

# Vault matter name prefix (only used by 02-vault-archive.sh).
VAULT_MATTER_PREFIX="SuspendedAudit"

# Where CSVs are written.
OUT_DIR="./output"
